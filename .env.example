# --- WhatsApp Cloud API (número NUEVO, dedicado a Compensar) ---
WHATSAPP_PHONE_NUMBER_ID=""        # Phone number ID del número nuevo en Meta Business Suite
WHATSAPP_BUSINESS_ACCOUNT_ID=""    # WABA ID
WHATSAPP_ACCESS_TOKEN=""           # Token permanente del System User de Meta
WHATSAPP_VERIFY_TOKEN="cambia-esto" # Token que tú inventas para verificar el webhook con Meta
WHATSAPP_TEMPLATE_NAME="compensar_recordatorio_entrega" # Nombre de la plantilla aprobada en Meta
WHATSAPP_TEMPLATE_LANG="es_CO"

# --- Anthropic (API key PROPIA de este proyecto, no la de Amanda) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Supabase (proyecto PROPIO — créalo separado del de aural-booking-system) ---
# Project Settings → API en tu proyecto de Supabase:
SUPABASE_URL=""             # "Project URL"
SUPABASE_KEY=""             # "service_role" key (NUNCA la "anon" key) — no la subas a ningún repo público

# --- Metas de agendamiento (backlog de entrega de audífonos) ---
DAILY_BATCH_SIZE=70   # cuántos pacientes recibe la plantilla cada día
DAILY_GOAL=70          # meta diaria que muestra el dashboard

# --- Aurora: documentos ---
SUPABASE_STORAGE_BUCKET="documentos-pacientes"  # bucket privado, créalo desde Supabase Storage
ORDEN_VIGENCIA_DIAS=90  # cuántos días de expedida se considera vigente una orden clínica — CONFIRMAR con Compensar, este es solo un valor por defecto

# --- Dashboard (GET /dashboard) ---
# El login ya NO usa variables de entorno: cada persona entra con su propio correo/clave,
# verificado contra Supabase Auth del mismo proyecto (Authentication → Users en tu
# Supabase). No hay nada que configurar aquí — solo crea ahí los usuarios que necesites.

# --- Servidor ---
PORT=8000
